# Linux production environment template (copy to .env on server)
# Do not commit real secrets.

NGINX_HTTP_PORT=80
PUBLIC_HOST=workplan.internal.local

DB_HOST=192.168.0.94
DB_PORT=3306
DB_USER=workplan_app
DB_PASSWORD=change_me
DB_NAME=esp_tracker

# Comma-separated CORS allowlist
CORS_ORIGINS=http://workplan.internal.local

# For browser calls. Leave empty when frontend and API share same origin through Nginx.
NEXT_PUBLIC_API_URL=

# For Next.js server-side requests inside container network
BACKEND_URL=http://backend:3101
