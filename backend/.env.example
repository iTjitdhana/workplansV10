# Backend Environment Configuration Template
# Copy this file to .env.development or .env.production

# Application
NODE_ENV=development
PORT=3102
PUBLIC_HOST=localhost

# Primary database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=workplan_app
DB_PASSWORD=change_me
DB_NAME=esp_tracker

# Optional logs database (if used by your deployment)
LOGS_DB_HOST=127.0.0.1
LOGS_DB_PORT=3306
LOGS_DB_USER=workplan_logs
LOGS_DB_PASSWORD=change_me
LOGS_DB_NAME=esp_tracker_logs

# CORS allowlist for production (comma-separated)
CORS_ORIGINS=http://localhost:3012
